<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <!-- Định nghĩa các Servlet -->
   <servlet>
    <servlet-name>UpdateProfileController</servlet-name>
    <servlet-class>Controllers.UpdateProfileController</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>UpdateProfileController</servlet-name>
    <url-pattern>/UpdateProfileController</url-pattern>
</servlet-mapping>


    <servlet>
        <servlet-name>ProductController</servlet-name>
        <servlet-class>Controllers.ProductController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>HomepageController</servlet-name>
        <servlet-class>Controllers.HomepageController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ProductListController</servlet-name>
        <servlet-class>Controllers.ProductListController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ProductDetailController</servlet-name>
        <servlet-class>Controllers.ProductDetailController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CartController</servlet-name>
        <servlet-class>Controllers.CartController</servlet-class>
    </servlet>
    <!-- Mapping URL đến các Servlet -->
    <servlet>
        <servlet-name>StaffManagePostsController</servlet-name>
        <servlet-class>Controllers.StaffManagePostsController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>StaffManageCommentsController</servlet-name>
        <servlet-class>Controllers.StaffManageCommentsController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomepageController</servlet-name>
        <url-pattern>/Home</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ProductListController</servlet-name>
        <url-pattern>/ProductList</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ProductDetailController</servlet-name>
        <url-pattern>/ProductDetail</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CartController</servlet-name>
        <url-pattern>/Cart</url-pattern>
    </servlet-mapping>
    <!-- Cấu hình Session -->
    <servlet-mapping>
        <servlet-name>StaffManagePostsController</servlet-name>
        <url-pattern>/StaffManagePostsController</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>StaffManageCommentsController</servlet-name>
        <url-pattern>/StaffManageCommentsController</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
    <!-- Thêm các Servlet khác -->
    <servlet>
        <servlet-name>VerifyEmailController</servlet-name>
        <servlet-class>Controllers.VerifyEmailController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>LoginController</servlet-name>
        <servlet-class>Controllers.LoginController</servlet-class>
    </servlet>
    <!-- Mapping URL đến các Servlet -->
    <servlet-mapping>
        <servlet-name>VerifyEmailController</servlet-name>
        <url-pattern>/verifyEmail</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>VerifyEmailController</servlet-name>
        <url-pattern>/resendCode</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LoginController</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <welcome-file-list>
        <welcome-file>login</welcome-file>
    </welcome-file-list>
    <servlet>
        <servlet-name>CustomerPostController</servlet-name>
        <servlet-class>Controllers.CustomerPostController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CustomerUpdatePostController</servlet-name>
        <servlet-class>Controllers.CustomerUpdatePostController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CustomerCommentController</servlet-name>
        <servlet-class>Controllers.CustomerCommentController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CustomerPostController</servlet-name>
        <url-pattern>/CustomerPostController</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CustomerUpdatePostController</servlet-name>
        <url-pattern>/CustomerUpdatePostController</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CustomerCommentController</servlet-name>
        <url-pattern>/CustomerCommentController</url-pattern>
    </servlet-mapping>
</web-app>
